# Geometrie und Physik initialisieren
/run/initialize

# Ausgabe steuern
/run/verbose 1
/event/verbose 0
/tracking/verbose 1

# Einstellungen der Particle Gun können hier
# ohne Neukompilieren überschrieben werden.
/gun/particle gamma
/gun/energy 1 MeV
/gun/position 0 0 -40 cm
/gun/direction 0 0 1

# Genau ein Event simulieren
/run/beamOn 1