/run/initialize

/vis/open OGL
/vis/drawVolume
/vis/viewer/set/autoRefresh true

# Hide the World volume's outline; it is only a container, not a real detector part.
# /vis/geometry/set/visibility World 0 false

/vis/scene/add/trajectories rich smooth

# Draw electron trajectories thicker than other particles.
# "set" captures the *current* default line width, so bump it up only
# right before registering e-, then restore it for everything else.
# /vis/modeling/trajectories/create/drawByParticleID
# /vis/modeling/trajectories/drawByParticleID-0/default/setLineWidth 5
# /vis/modeling/trajectories/drawByParticleID-0/set opticalphoton cyan
# /vis/modeling/trajectories/drawByParticleID-0/default/setLineWidth 3
# /vis/modeling/trajectories/drawByParticleID-0/set e- red
# /vis/modeling/trajectories/drawByParticleID-0/default/setLineWidth 1
# /vis/modeling/trajectories/list
# /vis/modeling/trajectories/select drawByParticleID-0

# BEGIN TEMPORARY: draw only the electron and Cerenkov trajectories.
# Comment out this complete block later to draw all trajectories again.
# /vis/filtering/trajectories/create/particleFilter
# /vis/filtering/trajectories/particleFilter-0/add opticalphoton
# /vis/filtering/trajectories/particleFilter-0/add e-
# /vis/filtering/trajectories/create/attributeFilter
# /vis/filtering/trajectories/attributeFilter-0/setAttribute CPN
# /vis/filtering/trajectories/attributeFilter-0/addValue Cerenkov
# /vis/filtering/trajectories/attributeFilter-0/addValue None
# /vis/filtering/trajectories/mode hard
# END TEMPORARY TRAJECTORY FILTER

/vis/scene/endOfEventAction refresh

# BEGIN TEMPORARY: electron incidence angle is 40 degrees in the y-z plane.
# The angle is measured from the original +z beam direction.
# /gun/direction 0.0 0.642788 0.766044
# END TEMPORARY ELECTRON ANGLE

/run/beamOn 1